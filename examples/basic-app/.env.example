# Copy to .env.local (gitignored) and fill in for your environment.
#
# Local stack values (`supabase start`) live in the project's `.env`, which
# `supabase init` generates. Point at it from here for convenience:

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY=""   # see `supabase status --output env` after start
