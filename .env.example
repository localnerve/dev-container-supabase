# Copy to .env and fill in for your machine:  cp .env.example .env

# =============================================================================
# Version source of truth (passed as build args in docker-compose.yml)
#   NODE_MAJOR:  https://hub.docker.com/r/mcr/microsoft/devcontainers/typescript-node/tags
#   BUN_VERSION: https://bun.sh / https://github.com/oven-sh/bun/releases
#   SUPABASE_VERSION: leave empty for "latest", or pin e.g. 2.122.0 to match CI
# =============================================================================
NODE_MAJOR=24
BUN_VERSION=1.4.4
SUPABASE_VERSION=

# =============================================================================
# Paths and sockets (machine-specific)
# =============================================================================

# Path to your projects directory, mounted at /workspace in the container.
PROJECTS_PATH=/Users/youruser/projects

# macOS ssh-agent socket (Docker Desktop convention).
SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock

# =============================================================================
# Docker-in-Docker sidecar (docker:dind)
# =============================================================================
# Version for the DinD daemon image. The image lives on the official `docker`
# repo as a tag suffixed with `-dind`, so compose runs `docker:<ver>-dind`. Pin
# it to match your host Docker client (29.9.2 here). Leave as-is unless you
# change Docker Desktop — mismatched major versions can confuse the CLI. The
# daemon runs inside the stack over the shared netns; no host socket path is
# needed (this replaced the old DOCKER_SOCK/DOCKER_GID DooD settings).
DIND_VERSION=29.9.2
